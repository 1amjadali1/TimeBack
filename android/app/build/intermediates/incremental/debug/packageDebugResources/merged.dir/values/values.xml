    <string name="accessibility_service_description">TimeBack uses Accessibility Services solely to count short-form videos (Reels and Shorts) scrolled across supported apps and enforce your daily limits for digital wellbeing. It never reads messages, collects personal data, or tracks private content.</string>
    <string name="accessibility_service_label">TimeBack Reel Counter &amp; Blocker</string>
    <string name="app_name">TimeBack</string>
    <string name="block_overlay_subtitle">Take a deep breath and take your time back from doomscrolling.</string>
    <string name="block_overlay_title">TimeBack Limit Reached!</string>
    <string name="notification_channel_desc">Shows ongoing reel count and limits</string>
    <string name="notification_channel_name">TimeBack Reel Counter</string>
    <style name="Theme.TimeBack" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/midnight_bg</item>
        <item name="android:navigationBarColor">@color/midnight_bg</item>
        <item name="android:windowBackground">@color/midnight_bg</item>
    </style>
    <style name="Theme.TimeBack.Overlay" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>
